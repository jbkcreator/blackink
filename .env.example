# =============================================================================
# BLACKINK — Environment Variables Reference
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# --- Core ---
DATABASE_URL=
# App-role DSN used by the running application. Must point at the blackink_app
# Postgres role (RLS-subject, no BYPASSRLS) — never the schema-owning/migration
# role, or Row-Level Security silently no-ops for every query the app runs.
# See migrations/apply_db_roles.py and docs/adr/0001-tenant-isolation-rls-plus-app-layer.md.
DATABASE_URL_APP=
# System-role DSN (BYPASSRLS) — reserved exclusively for internal batch jobs
# (promotion sweep, county-allocation reassessment, leakage-test harness).
# Request-handling code (src/api/) must never import the code path that uses this.
DATABASE_URL_SYSTEM=
# Akrash's restricted DSN — INSERT-only on raw_prospect_companies/raw_prospect_contacts.
DATABASE_URL_AKRASH=
# Passwords for migrations/apply_db_roles.py to provision the three Postgres roles.
BLACKINK_APP_DB_PASSWORD=
BLACKINK_SYSTEM_DB_PASSWORD=
AKRASH_INGEST_DB_PASSWORD=
REDIS_URL=
DEBUG=
DB_ECHO=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
APP_BASE_URL=

# --- Compliance gate ---
# Tracerfy account key -- serves both the DNC scrub AND skip-trace owner
# enrichment (Subtask 3.2.1). Renamed from DNC_VENDOR_API_KEY.
TRACERFY_API_KEY=
DNC_RECHECK_DAYS=
EMAIL_VERIFICATION_VENDOR_API_KEY=
NON_POACH_LOCK_PERMANENT=

# --- Owner enrichment (Subtask 3.2.1) ---
OWNER_ENRICHMENT_MAX_PER_RUN=
OWNER_ENRICHMENT_MAX_ATTEMPTS=

# --- Instantly (Email Outreach / Deliverability) ---
INSTANTLY_API_KEY=
INSTANTLY_BASE_URL=
INSTANTLY_ENABLED=

# --- Deliverability Sentinel thresholds ---
DELIVERABILITY_BOUNCE_RATE_THRESHOLD_PCT=
DELIVERABILITY_SPAM_COMPLAINT_THRESHOLD_PCT=

# --- Relay halt / resume (src/agents/relay/) ---
# HMAC-SHA256 signing key for cryptographic resume tokens. 32+ bytes of
# entropy, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
RELAY_RESUME_SECRET=

# --- Slack ---
# Week 0 runs Socket Mode (no public HTTPS endpoint yet) — see
# Tasks/dev-3-slack-agent-hub-week0.md. SLACK_APP_TOKEN (xapp-...) is the
# Socket Mode connection credential, distinct from the bot token below;
# switching to HTTP webhooks later drops its use but not the field.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# --- Slack channel IDs (config/slack_channels.py — six channels, per
# blueprint §3.0.3: two carry no "blackink-" prefix, that's correct) ---
BLACKINK_COMMAND_SLACK_CHANNEL=
BLACKINK_SETTER_SLACK_CHANNEL=
SALES_REPLIES_SLACK_CHANNEL=
DIAL_TASKS_SLACK_CHANNEL=
BLACKINK_QA_SLACK_CHANNEL=
BLACKINK_ECONOMICS_SLACK_CHANNEL=

# Fail-closed approver allowlist (src/services/slack/auth.py) — empty
# means NOBODY is authorized, never everybody. Comma-separated Slack user
# IDs, e.g. "U012ABC,U034DEF".
BLACKINK_GLOBAL_APPROVERS=

# --- Akrash ingestion ---
AKRASH_INGEST_JWT_SECRET=

# --- No-Show Handler / Owner Score Self-Serve Landing Page (Subtask 3.2.3) ---
# HMAC secret for the "Mark No-Show" Slack button's booking-scoped token
# (src/services/no_show_prompts.py) — its own secret, not a reuse of
# RELAY_RESUME_SECRET; unrelated token families rotate independently.
NO_SHOW_TOKEN_SECRET=
# Comma-separated exact hostnames the no-show recovery email / landing
# page redirect is allowed to send a prospect to (e.g. a real GHL
# calendar domain, calendar.google.com, outlook.office.com). Empty means
# fail-closed: resolve_booking_link() returns no redirect until this is
# configured — same posture as OVS_PDF_ALLOWED_HOSTS.
BOOKING_REDIRECT_ALLOWED_HOSTS=
# Optional — the /audit landing page renders no pixel <script> at all
# when unset.
META_PIXEL_ID=
GOOGLE_TAG_ID=
# Per-IP-hash submissions allowed per 10-minute window on the public
# /api/v1/public/owner-score-audit endpoint.
SELF_SERVE_RATE_LIMIT_PER_10MIN=5
# --- Prospecting data sources ---
GOOGLE_PLACES_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# --- Inbound Booking Engine (Subtask 3.2.1/3.2.2) ---
# Google Calendar + Microsoft Graph OAuth apps. The redirect URI registered
# in each provider's console must exactly match
# {CALENDAR_WEBHOOK_BASE_URL}/api/v1/calendar/oauth/callback/{provider}.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Fernet.generate_key() output, generated once and kept stable — rotating
# it makes every previously-encrypted OAuth token undecryptable.
TOKEN_ENCRYPTION_KEY=
# Any random secret string; signs connect-link/OAuth-state JWTs.
CALENDAR_OAUTH_STATE_SECRET=
# This service's own public HTTPS URL — builds both the OAuth redirect URI
# and the webhook URLs handed to Google/Microsoft/GHL at subscribe time.
# localhost doesn't work; see CLAUDE.md's Cloud Run deployment section.
CALENDAR_WEBHOOK_BASE_URL=
# Set true only in local dev to skip registering a real (unreachable)
# push subscription — see calendar_oauth_router.py/calendar_subscription_renewal.py.
SKIP_CALENDAR_WATCH_REGISTRATION=
# Leave False/unset unless real SMTP credentials for a validated sending
# domain exist — see src/services/email_dispatch.py.
EMAIL_SENDING_ENABLED=
# Comma-separated exact hostnames the pre-demo reminder may fetch
# contacts.ovs_pdf_url from. Empty means fail closed.
OVS_PDF_ALLOWED_HOSTS=

# --- Demo sandbox dashboard export (src/tasks/seed_demo_sandbox.py) ---
# Service account JSON key for the Google Sheets/Drive APIs — keep the file
# itself in the gitignored secrets/ directory, never commit it. Path is
# relative to the repo root; use forward slashes even on Windows if the
# server runtime is Linux (a literal backslash won't resolve there).
GOOGLE_SHEETS_CREDENTIALS_PATH=
# The target Sheet's ID (the long string in its URL between /d/ and /edit).
GOOGLE_SHEETS_SANDBOX_ID=
