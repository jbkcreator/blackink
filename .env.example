# =============================================================================
# BLACKINK — Environment Variables Reference
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# --- Core ---
DATABASE_URL=
# App-role DSN used by the running application. Must point at the blackink_app
# Postgres role (RLS-subject, no BYPASSRLS) — never the schema-owning/migration
# role, or Row-Level Security silently no-ops for every query the app runs.
# See migrations/apply_db_roles.py and docs/adr/0001-tenant-isolation-rls-plus-app-layer.md.
DATABASE_URL_APP=
# System-role DSN (BYPASSRLS) — reserved exclusively for internal batch jobs
# (promotion sweep, county-allocation reassessment, leakage-test harness).
# Request-handling code (src/api/) must never import the code path that uses this.
DATABASE_URL_SYSTEM=
# Akrash's restricted DSN — INSERT-only on raw_prospect_companies/raw_prospect_contacts.
DATABASE_URL_AKRASH=
# Passwords for migrations/apply_db_roles.py to provision the three Postgres roles.
BLACKINK_APP_DB_PASSWORD=
BLACKINK_SYSTEM_DB_PASSWORD=
AKRASH_INGEST_DB_PASSWORD=
REDIS_URL=
DEBUG=
DB_ECHO=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
APP_BASE_URL=

# --- Compliance gate ---
DNC_VENDOR_API_KEY=
DNC_RECHECK_DAYS=
EMAIL_VERIFICATION_VENDOR_API_KEY=
NON_POACH_LOCK_PERMANENT=

# --- Instantly (Email Outreach / Deliverability) ---
INSTANTLY_API_KEY=
INSTANTLY_BASE_URL=
INSTANTLY_ENABLED=

# --- Deliverability Sentinel thresholds ---
DELIVERABILITY_BOUNCE_RATE_THRESHOLD_PCT=
DELIVERABILITY_SPAM_COMPLAINT_THRESHOLD_PCT=

# --- Relay halt / resume (src/agents/relay/) ---
# HMAC-SHA256 signing key for cryptographic resume tokens. 32+ bytes of
# entropy, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
RELAY_RESUME_SECRET=

# --- Slack ---
# Week 0 runs Socket Mode (no public HTTPS endpoint yet) — see
# Tasks/dev-3-slack-agent-hub-week0.md. SLACK_APP_TOKEN (xapp-...) is the
# Socket Mode connection credential, distinct from the bot token below;
# switching to HTTP webhooks later drops its use but not the field.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# --- Slack channel IDs (config/slack_channels.py — six channels, per
# blueprint §3.0.3: two carry no "blackink-" prefix, that's correct) ---
BLACKINK_COMMAND_SLACK_CHANNEL=
BLACKINK_SETTER_SLACK_CHANNEL=
SALES_REPLIES_SLACK_CHANNEL=
DIAL_TASKS_SLACK_CHANNEL=
BLACKINK_QA_SLACK_CHANNEL=
BLACKINK_ECONOMICS_SLACK_CHANNEL=

# Fail-closed approver allowlist (src/services/slack/auth.py) — empty
# means NOBODY is authorized, never everybody. Comma-separated Slack user
# IDs, e.g. "U012ABC,U034DEF".
BLACKINK_GLOBAL_APPROVERS=

# --- Akrash ingestion ---
AKRASH_INGEST_JWT_SECRET=
